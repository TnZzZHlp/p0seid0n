{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "theme-switcher",
  "type": "registry:ui",
  "title": "Theme Switcher",
  "description": "Ghost button opening a radio menu with system, light and dark choices.",
  "registryDependencies": [
    "theme",
    "theme-provider",
    "button",
    "dropdown-menu"
  ],
  "docs": "Requires a ThemeProvider above it and uses useTheme(), so the menu, the html class and localStorage always agree. The icon slot receives the current choice for rendering a matching icon. Labels default to System, Light and Dark and can be overridden per locale.",
  "files": [
    {
      "path": "ui/theme-switcher/ThemeSwitcher.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\">\nimport { computed } from 'vue'\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuRadioGroup,\n  DropdownMenuRadioItem,\n  DropdownMenuTrigger,\n} from '../dropdown-menu'\nimport { Button } from '../button'\nimport { useTheme } from '../theme-provider'\nimport type { ThemeChoice } from '../theme-provider'\n\ndefineOptions({ inheritAttrs: false })\n\nexport type ThemeSwitcherProps = {\n  /** Accessible name for the trigger. */\n  label?: string\n  labels?: Record<ThemeChoice, string>\n}\n\nconst props = withDefaults(defineProps<ThemeSwitcherProps>(), {\n  label: 'Appearance',\n  labels: () => ({ system: 'System', light: 'Light', dark: 'Dark' }),\n})\n\nconst { theme, setTheme } = useTheme()\n\nconst choices: readonly ThemeChoice[] = ['system', 'light', 'dark']\n\n// The radio group wants a plain string model; the injected ref stays the single source.\nconst model = computed({\n  get: () => theme.value,\n  set: (next: string) => setTheme(next as ThemeChoice),\n})\n</script>\n\n<template>\n  <DropdownMenu v-bind=\"$attrs\">\n    <DropdownMenuTrigger as-child>\n      <Button variant=\"ghost\" size=\"sm\" :aria-label=\"props.label\">\n        <slot name=\"icon\" :theme=\"theme\">\n          <span data-theme-label>{{ props.labels[theme] }}</span>\n        </slot>\n      </Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent align=\"end\" :min-width=\"160\">\n      <DropdownMenuRadioGroup v-model=\"model\">\n        <DropdownMenuRadioItem\n          v-for=\"choice in choices\"\n          :key=\"choice\"\n          :value=\"choice\"\n          :data-testid=\"`theme-${choice}`\"\n        >\n          {{ props.labels[choice] }}\n        </DropdownMenuRadioItem>\n      </DropdownMenuRadioGroup>\n    </DropdownMenuContent>\n  </DropdownMenu>\n</template>\n"
    },
    {
      "path": "ui/theme-switcher/index.ts",
      "type": "registry:ui",
      "content": "export { default as ThemeSwitcher } from './ThemeSwitcher.vue'\nexport type { ThemeSwitcherProps } from './ThemeSwitcher.vue'\n"
    }
  ]
}
