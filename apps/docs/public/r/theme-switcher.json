{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "theme-switcher",
  "type": "registry:ui",
  "title": "Theme Switcher",
  "description": "Ghost button opening a radio menu with system, light and dark choices.",
  "dependencies": [
    "@ui-sdk/vue@0.1.0-beta.14",
    "@ui-sdk/core@0.1.0-beta.14"
  ],
  "registryDependencies": [
    "theme",
    "theme-provider",
    "button",
    "dropdown-menu"
  ],
  "docs": "Requires a ThemeProvider above it and uses useTheme(), so the menu, the html class and localStorage always agree. The icon slot receives the current choice for rendering a matching icon. Labels default to System, Light and Dark and can be overridden per locale.",
  "files": [
    {
      "path": "ui/theme-switcher/ThemeSwitcher.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\">\nimport { Menu, MenuItemIndicator, MenuRadioGroup, MenuRadioItem } from '@ui-sdk/vue/menu'\nimport { DropdownMenuContent, DropdownMenuTrigger } from '../dropdown-menu'\nimport { menuItem } from '../dropdown-menu/styles'\nimport { Button } from '../button'\nimport { useTheme } from '../theme-provider'\nimport type { ThemeChoice } from '../theme-provider'\n\ndefineOptions({ inheritAttrs: false })\n\nexport type ThemeSwitcherProps = {\n  /** Accessible name for the trigger. */\n  label?: string\n  labels?: Record<ThemeChoice, string>\n}\n\nconst props = withDefaults(defineProps<ThemeSwitcherProps>(), {\n  label: 'Appearance',\n  labels: () => ({ system: 'System', light: 'Light', dark: 'Dark' }),\n})\n\nconst { theme, setTheme } = useTheme()\n\nconst choices: readonly ThemeChoice[] = ['system', 'light', 'dark']\n\nfunction onThemeChange(next: string | null) {\n  if (next === 'system' || next === 'light' || next === 'dark') setTheme(next)\n}\n</script>\n\n<template>\n  <Menu :modal=\"false\" v-bind=\"$attrs\">\n    <DropdownMenuTrigger as-child>\n      <Button variant=\"ghost\" size=\"sm\" :aria-label=\"props.label\">\n        <slot name=\"icon\" :theme=\"theme\">\n          <span data-theme-label>{{ props.labels[theme] }}</span>\n        </slot>\n      </Button>\n    </DropdownMenuTrigger>\n    <DropdownMenuContent align=\"end\" :min-width=\"160\">\n      <MenuRadioGroup :value=\"theme\" :aria-label=\"props.label\" @update:value=\"onThemeChange\">\n        <MenuRadioItem\n          v-for=\"choice in choices\"\n          :key=\"choice\"\n          :value=\"choice\"\n          :close-on-select=\"true\"\n          :data-testid=\"`theme-${choice}`\"\n          :class=\"menuItem\"\n        >\n          <span class=\"flex size-3.5 shrink-0 items-center justify-center\">\n            <MenuItemIndicator class=\"before:hidden\">\n              <span class=\"block size-1.5 rounded-full bg-ink\" />\n            </MenuItemIndicator>\n          </span>\n          {{ props.labels[choice] }}\n        </MenuRadioItem>\n      </MenuRadioGroup>\n    </DropdownMenuContent>\n  </Menu>\n</template>\n"
    },
    {
      "path": "ui/theme-switcher/index.ts",
      "type": "registry:ui",
      "content": "export { default as ThemeSwitcher } from './ThemeSwitcher.vue'\nexport type { ThemeSwitcherProps } from './ThemeSwitcher.vue'\n"
    }
  ]
}
