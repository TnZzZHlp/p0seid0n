{
  "name": "label",
  "type": "registry:ui",
  "title": "Label",
  "description": "Caption that associates with a control through its for attribute, with an optional required marker.",
  "dependencies": [
    "clsx",
    "tailwind-merge"
  ],
  "registryDependencies": [
    "utils",
    "theme"
  ],
  "docs": "Pass for with the id of the control. required appends a decorative asterisk in the danger colour; it is hidden from assistive tech, so keep the native required or aria-required attribute on the control itself.",
  "files": [
    {
      "path": "ui/label/Label.vue",
      "type": "registry:ui",
      "content": "<script setup lang=\"ts\">\nimport { computed, useAttrs } from 'vue'\nimport { cn } from '@/lib/utils'\n\ndefineOptions({ inheritAttrs: false })\n\nconst attrs = useAttrs()\nconst forwarded = computed(() => {\n  const rest = { ...attrs }\n  delete rest.class\n  return rest\n})\n\nexport type LabelProps = {\n  /** Id of the control this label describes; rendered as the `for` attribute. */\n  for?: string\n  /** Appends a decorative required marker. */\n  required?: boolean\n}\n\nwithDefaults(defineProps<LabelProps>(), {\n  for: undefined,\n  required: false,\n})\n</script>\n\n<template>\n  <label\n    v-bind=\"forwarded\"\n    :for=\"$props.for\"\n    :class=\"\n      cn(\n        'inline-flex items-center gap-1 text-[13px] font-medium text-ink-muted',\n        $attrs.class as string | undefined,\n      )\n    \"\n  >\n    <slot />\n    <span v-if=\"required\" aria-hidden=\"true\" class=\"text-danger\">*</span>\n  </label>\n</template>\n"
    },
    {
      "path": "ui/label/index.ts",
      "type": "registry:ui",
      "content": "export { default as Label } from './Label.vue'\nexport type { LabelProps } from './Label.vue'\n"
    }
  ]
}
