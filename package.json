{
  "name": "p0seid0n-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build:registry": "node scripts/build-registry/index.ts",
    "ui:install": "node scripts/install-ui.ts",
    "docs:dev": "pnpm ui:install && pnpm -C apps/docs dev",
    "docs:build": "pnpm ui:install && pnpm -C apps/docs build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p apps/docs/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docs:preview": "pnpm -C apps/docs preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^25.9.9",
    "@typescript-eslint/parser": "^8.72.2",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "reka-ui": "2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^3.3.14"
  }
}
